{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiPin",
  "version": "0.1.0-alpha.1",
  "identifier": "com.aipin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "windows": [
      {
        "label": "main",
        "create": true,
        "url": "index.html",
        "title": "AiPin",
        "width": 1100,
        "height": 480,
        "minWidth": 320,
        "minHeight": 110,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "skipTaskbar": false
      },
      {
        "label": "settings",
        "create": false,
        "url": "index.html?window=settings",
        "title": "AiPin 设置",
        "width": 900,
        "height": 680,
        "minWidth": 280,
        "minHeight": 240,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
